generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OcrStatus {
  PENDING
  SUCCESS
  FAILED
  FALLBACK_USED
}

enum FoodItemStatus {
  ACTIVE
  USED
  WASTED
}

enum FoodItemSource {
  RECEIPT
  MANUAL
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String         @id
  email         String         @unique
  fullName      String
  role          UserRole       @default(USER)
  accountStatus AccountStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  receipts      Receipt[]
  foodItems     FoodItem[]
}

model Category {
  id            String            @id @default(cuid())
  name          String            @unique
  shelfLifeDays Int
  draftItems    ReceiptItemDraft[]
  foodItems     FoodItem[]
  usedItems     UsedItem[]
  wastedItems   WastedItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Receipt {
  id           String            @id @default(cuid())
  imagePath    String
  ocrStatus    OcrStatus         @default(PENDING)
  uploadedAt   DateTime          @default(now())

  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  draftItems   ReceiptItemDraft[]
  foodItems    FoodItem[]        @relation("ReceiptFoodItems")
  usedItems    UsedItem[]        @relation("ReceiptUsedItems")
  wastedItems  WastedItem[]      @relation("ReceiptWastedItems")
}

model ReceiptItemDraft {
  id          String    @id @default(cuid())
  receiptId   String
  receipt     Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  name        String
  quantity    Int       @default(1)

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  confidence  Float?
  isSelected  Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FoodItem {
  id           String          @id @default(cuid())
  name         String
  quantity     Int             @default(1)

  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])

  source       FoodItemSource
  status       FoodItemStatus  @default(ACTIVE)

  dateAdded    DateTime        @default(now())

  receiptId    String?
  receipt      Receipt?        @relation("ReceiptFoodItems", fields: [receiptId], references: [id])
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  usedEntry    UsedItem?
  wastedEntry  WastedItem?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model UsedItem {
  id            String         @id @default(cuid())
  foodItemId    String         @unique
  foodItem      FoodItem       @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  name          String
  quantity      Int

  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])

  source        FoodItemSource

  receiptId     String?
  receipt       Receipt?       @relation("ReceiptUsedItems", fields: [receiptId], references: [id])

  markedUsedAt  DateTime       @default(now())
  createdAt     DateTime       @default(now())
}

model WastedItem {
  id              String         @id @default(cuid())
  foodItemId      String         @unique
  foodItem        FoodItem       @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  name            String
  quantity        Int

  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])

  source          FoodItemSource

  receiptId       String?
  receipt         Receipt?       @relation("ReceiptWastedItems", fields: [receiptId], references: [id])

  markedWastedAt  DateTime       @default(now())
  createdAt       DateTime       @default(now())
}
